                    B: "Sekali pekerja layak dan mendaftar di bawah Akta 4/Akta 800, pekerja tersebut kekal tertakluk kepada caruman berterusan selagi masih berstatus pekerja aktif, walaupun gajinya berubah.",
                    C: "Majikan dikecualikan daripada mencarum bagi bulan di mana gaji pekerja terjejas akibat cuti tanpa gaji.",
                    D: "Pekerja dikehendaki memohon lesen perniagaan baharu di bawah Ordinan Buruh Sabah."
                },
                ans: "B"
            },
            {
                no: 18,
                q: "Encik Kumar bekerja dengan dua majikan berbeza (Syarikat X pada waktu pagi dan Syarikat Y pada waktu malam). Berkenaan caruman Skim LINDUNG 24 Jam (SKBBK) yang dibiayai oleh pekerja, bagaimanakah caruman ini diselaraskan mengikut garis panduan rasmi PERKESO?",
                options: {
                    A: "Syarikat X dan Syarikat Y wajib membuat potongan 0.75% secara serentak daripada kedua-dua gajinya.",
                    B: "Encik Kumar perlu memilih SALAH SATU majikan sahaja untuk membuat pemotongan caruman LINDUNG 24 Jam dengan melengkapkan borang pilihan majikan.",
                    C: "Kedua-dua majikan dikecualikan daripada memotong caruman kerana terdapat pertindihan perkhidmatan.",
                    D: "Pemotongan caruman disalurkan terus ke akaun SKSSR suaminya."
                },
                ans: "B"
            },
            {
                no: 19,
                q: "Sebuah syarikat didapati dengan sengaja memotong 1.75% gaji pekerja bagi membayar syer MAJIKAN di bawah Kategori Pertama Akta 4, di samping memotong 0.5% syer pekerja. Apakah rumusan undang-undang yang tepat mengenai tindakan majikan ini di bawah Akta 4?",
                options: {
                    A: "Tindakan majikan adalah sah sekiranya terdapat persetujuan dalam Surat Tawaran Kerja.",
                    B: "Tindakan majikan adalah tidak sah dan merupakan kesalahan jenayah di bawah Akta 4 kerana syer majikan adalah tanggungan mutlak majikan dan dilarang dipindahkan kepada pekerja.",
                    C: "Majikan dibenarkan melakukan potongan tersebut jika syarikat mencatatkan kerugian tahunan.",
                    D: "Pemotongan tersebut dipindahkan secara automatik ke dalam dividen Akaun 1 KWSP pekerja."
                },
                ans: "B"
            },
            {
                no: 20,
                q: "Puan Linda memilih untuk keluar (opt-out) daripada Skim LINDUNG 24 Jam (SKBBK) melalui Portal PRIHATIN semasa tempoh bertenang. Namun begitu, majikannya tersilap memotong caruman RM18.75 daripada gajinya pada bulan Julai 2026. Bagaimanakah prosedur bayaran balik (refund) caruman tersebut dilaksanakan mengikut tatacara PERKESO?",
                options: {
                    A: "Puan Linda mesti hadir ke kaunter PERKESO untuk menuntut bayaran balik secara tunai.",
                    B: "Tuntutan bayaran balik caruman (refund) mesti dikemukakan oleh MAJIKAN melalui Portal ASSIST di bawah Modul Inspection (Bayaran Balik).",
                    C: "Wang caruman dipindahkan secara automatik sebagai dividen i-Suri KWSP.",
                    D: "Tuntutan refund tidak disokong dan wang tersebut dikira hangus disisi undang-undang."
                },
                ans: "B"
            }
        ];

        let studentDetails = {};
        const studentAnswers = {};
        let timerInterval = null;
        let timeRemaining = 30 * 60; // 30 minit

        window.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('hasTakenQuiz_GWR061_K2') === 'true') {
                alert("Anda telah mengambil penilaian ini. Setiap pelajar hanya dibenarkan mengambil ujian ini SEKALI sahaja.");
                document.body.innerHTML = `
                    <div class="min-h-screen flex items-center justify-center bg-gray-100 p-4">
                        <div class="bg-white p-8 rounded-lg shadow-md text-center max-w-md border border-red-300">
                            <h2 class="text-xl font-bold text-red-600 mb-2">AKSES DIHALANG</h2>
                            <p class="text-sm text-gray-700">Anda telah menghantar KUIZ 2 (GWR061) ini sebelum ini. Penilaian hanya boleh diambil satu kali sahaja.</p>
                        </div>
                    </div>
                `;
            }
        });

        function startQuiz(e) {
            e.preventDefault();
            studentDetails = {
                nama: document.getElementById('inputNama').value,
                ic: document.getElementById('inputIC').value,
                ndp: document.getElementById('inputNDP').value,
                kelas: document.getElementById('inputKelas').value,
                sesi: document.getElementById('inputSesi').value,
                tarikh: document.getElementById('inputTarikh').value,
                pengajar: document.getElementById('inputPengajar').value
            };

            document.getElementById('studentFormSection').classList.add('hidden');
            document.getElementById('quizQuestionsSection').classList.remove('hidden');
            
            renderQuestions();
            startTimer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                timeRemaining--;
                const minutes = Math.floor(timeRemaining / 60);
                const seconds = timeRemaining % 60;
                document.getElementById('timerDisplay').innerText = `Masa: ${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    alert("Masa 30 minit telah tamat! Jawapan anda akan dihantar secara automatik.");
                    autoSubmitAnswers();
                }
            }, 1000);
        }

        function renderQuestions() {
            const container = document.getElementById('questionsContainer');
            container.innerHTML = '';

            questionsData.forEach(q => {
                const qCard = document.createElement('div');
                qCard.className = 'border border-gray-200 rounded-lg p-5 bg-gray-50 hover:bg-white transition shadow-sm';
                
                let optionsHTML = '';
                for (const key in q.options) {
                    optionsHTML += `
                        <label class="flex items-start space-x-3 p-2.5 rounded hover:bg-blue-50 cursor-pointer border border-transparent hover:border-blue-200 transition">
                            <input type="radio" name="question_${q.no}" value="${key}" onchange="recordAnswer(${q.no}, '${key}')" class="mt-0.5 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300">
                            <span class="text-sm font-medium text-gray-800"><strong class="text-blue-900">${key}.</strong> ${q.options[key]}</span>
                        </label>
                    `;
                }

                qCard.innerHTML = `
                    <p class="font-bold text-base text-blue-950 mb-3">${q.no}. ${q.q}</p>
                    <div class="space-y-1.5">${optionsHTML}</div>
                `;
                container.appendChild(qCard);
            });
        }

        function recordAnswer(qNo, selectedOption) {
            studentAnswers[qNo] = selectedOption;
            const count = Object.keys(studentAnswers).length;
            document.getElementById('progressTracker').innerText = `${count} / 20 Dijawab`;
        }

        function submitAnswers(e) {
            e.preventDefault();
            if (Object.keys(studentAnswers).length < 20) {
                if (!confirm("Anda belum menjawab semua soalan. Adakah anda pasti mahu menghantar?")) {
                    return;
                }
            }
            processSubmission();
        }

        function autoSubmitAnswers() {
            processSubmission();
        }

        function processSubmission() {
            if (timerInterval) clearInterval(timerInterval);

            localStorage.setItem('hasTakenQuiz_GWR061_K2', 'true');

            document.getElementById('quizQuestionsSection').classList.add('hidden');
            document.getElementById('omrSection').classList.remove('hidden');

            generateOMR();
            hantarKeGoogleDrive();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function generateOMR() {
            document.getElementById('omrNama').innerText = studentDetails.nama;
            document.getElementById('omrIC').innerText = studentDetails.ic;
            document.getElementById('omrNDP').innerText = studentDetails.ndp;
            document.getElementById('omrKelas').innerText = studentDetails.kelas;
            document.getElementById('omrSesi').innerText = studentDetails.sesi;
            document.getElementById('omrTarikh').innerText = formatDate(studentDetails.tarikh);
            document.getElementById('omrPengajar').innerText = studentDetails.pengajar;
            document.getElementById('omrTarikhSemakan').innerText = formatDate(new Date().toISOString().split('T')[0]);

            let totalCorrect = 0;
            const col1 = document.getElementById('omrCol1');
            const col2 = document.getElementById('omrCol2');

            col1.innerHTML = '';
            col2.innerHTML = '';

            questionsData.forEach(q => {
                const userAns = studentAnswers[q.no] || null;
                const isCorrect = userAns === q.ans;
                if (isCorrect) totalCorrect++;

                const row = document.createElement('div');
                row.className = 'flex items-center justify-between py-1 border-b border-gray-200 last:border-b-0';

                let bubblesHTML = '';
                ['A', 'B', 'C', 'D'].forEach(opt => {
                    let isFilled = (userAns === opt);
                    let markHTML = '';

                    if (isFilled) {
                        if (isCorrect) {
                            markHTML = `<span class="omr-mark correct">✓</span>`;
                        } else {
                            markHTML = `<span class="omr-mark wrong">✗</span>`;
                        }
                    }

                    bubblesHTML += `
                        <div class="omr-bubble ${isFilled ? 'filled' : ''}">
                            ${opt}
                            ${markHTML}
                        </div>
                    `;
                });

                row.innerHTML = `
                    <span class="font-bold w-6 text-gray-700">${q.no.toString().padStart(2, '0')}.</span>
                    <div class="flex space-x-2">
                        ${bubblesHTML}
                    </div>
                `;

                if (q.no <= 10) col1.appendChild(row);
                else col2.appendChild(row);
            });

            const percentage = Math.round((totalCorrect / 20) * 100);
            document.getElementById('omrMarkahPercent').innerText = `${percentage}%`;
            document.getElementById('omrMarkahDetail').innerText = `(${totalCorrect} / 20 Soalan Betul)`;

            const isPassed = percentage >= 60;
            const badge = document.getElementById('omrKeputusanBadge');
            if (isPassed) {
                badge.innerText = "TERAMPIL";
                badge.className = "text-2xl font-black mt-1 px-4 py-1 rounded bg-green-100 text-green-800 border border-green-400";
            } else {
                badge.innerText = "BELUM TERAMPIL";
                badge.className = "text-2xl font-black mt-1 px-4 py-1 rounded bg-red-100 text-red-800 border border-red-400";
            }
        }

        function hantarKeGoogleDrive() {
            if (!SCRIPT_URL || SCRIPT_URL.includes("https://script.google.com/macros/s/AKfycbx6VkuQGRbqzhVusCTCZvr7SBXcHqDET1KH3lz0P_M5xhucqFpUYBsrQvfInPAODSEa2w/exec")) {
                console.warn("URL Google Apps Script belum ditetapkan.");
                return;
            }

            const omrClone = document.getElementById('omrSection').cloneNode(true);
            const noPrint = omrClone.querySelector('.no-print');
            if (noPrint) noPrint.remove();

            const fullHtml = `
                <!DOCTYPE html>
                <html>
                <head>
                    <meta charset="UTF-8">
                    <script src="https://cdn.tailwindcss.com"><\/script>
                    <style>
                        .omr-bubble {
                            width: 20px; height: 20px; border-radius: 50%;
                            border: 1px solid #333; display: inline-flex;
                            align-items: center; justify-content: center;
                            font-size: 9px; font-weight: bold; position: relative;
                        }
                        .omr-bubble.filled { background-color: #111 !important; color: #fff !important; }
                        .omr-mark { position: absolute; font-size: 14px; top: -3px; }
                        .omr-mark.correct { color: #16a34a; }
                        .omr-mark.wrong { color: #dc2626; }
                    </style>
                </head>
                <body class="p-4 bg-white text-gray-800">
                    ${omrClone.innerHTML}
                </body>
                </html>
            `;

            fetch(SCRIPT_URL, {
                method: "POST",
                mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    quizTitle: "KUIZ 2",
                    nama: studentDetails.nama,
                    ndp: studentDetails.ndp,
                    htmlContent: fullHtml
                })
            }).then(() => {
                const statusDiv = document.createElement('div');
                statusDiv.className = "bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded mb-4 text-center text-sm font-semibold";
                statusDiv.innerText = "✓ Salinan borang OMR (KUIZ 2) berjaya dihantar ke Google Drive pensyarah.";
                document.getElementById('omrSection').prepend(statusDiv);
            }).catch(err => {
                console.error("Ralat penghantaran:", err);
            });
        }

        function formatDate(str) {
            if (!str) return '';
            const parts = str.split('-');
            if (parts.length === 3) {
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return str;
        }
    </script>
</body>
</html>
